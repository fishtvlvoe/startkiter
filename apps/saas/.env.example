# Required runtime
DATABASE_URL=postgresql://user:password@localhost:5432/startkiter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Public URLs (optional locally; required when links must use the deployed origin)
NEXT_PUBLIC_SAAS_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_VERCEL_URL=

# Operator access and encrypted database-backed settings
# Empty ADMIN_EMAIL grants operator access to nobody.
ADMIN_EMAIL=
# Required to write PAYUNi/e-invoice settings; missing key makes writes fail closed.
SETTINGS_ENCRYPTION_KEY=

# PAYUNi fallback credentials (checkout returns 503 when the database and these values are incomplete)
PAYUNI_MERCHANT_ID=
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=
PAYUNI_API_URL=https://sandbox-api.payuni.com.tw/api/upp

# Taiwan e-invoice settings are normally stored encrypted through the operator settings page.
# These legacy names are retained here only for deployments that still provide them externally.
EINVOICE_PROVIDER=ezpay
EINVOICE_MERCHANT_ID=
EINVOICE_HASH_KEY=
EINVOICE_HASH_IV=
EINVOICE_TEST_MODE=true
EINVOICE_ENABLED=false

# Authentication providers (optional; unavailable providers stay disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_COMMUNITY_INVITE_URL=

# LINE Messaging support (optional; webhook/channel features fail closed when incomplete)
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=

# GitHub kit fulfillment (required only when kit fulfillment is enabled)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_KIT_ORG=
GITHUB_KIT_REPO=
GITHUB_KIT_TEMPLATE_REPO=

# Upload storage (required only for assignment/media/message uploads)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_ASSIGNMENTS_BUCKET_NAME=
NEXT_PUBLIC_AVATARS_BUCKET_NAME=
NEXT_PUBLIC_LESSON_MESSAGES_BUCKET_NAME=
NEXT_PUBLIC_MEDIA_BUCKET_NAME=
NEXT_PUBLIC_CHATWOOT_BASE_URL=
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# Support integrations (optional)
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_WEBHOOK_DEBUG=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Mail providers (configure the provider selected by the application)
MAIL_FROM=
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
POSTMARK_SERVER_TOKEN=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
SUPPORT_EMAIL=

# AI features (optional; AI routes fail closed when the key is missing)
OPENAI_API_KEY=

# Optional legacy payment-provider configuration retained by the shared payments package
PRICE_ID_LIFETIME=
PRICE_ID_PRO_MONTHLY=
PRICE_ID_PRO_YEARLY=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Deployment management (optional; deployment actions fail closed when incomplete)
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_APP_REPO_URL=
COOLIFY_APP_GIT_BRANCH=main
COOLIFY_PRIVATE_KEY_UUID=

# Scheduled cleanup secrets (required only when the corresponding cron endpoint is enabled)
ASSIGNMENT_UPLOAD_CLEANUP_SECRET=
LESSON_MESSAGE_UPLOAD_CLEANUP_SECRET=

# Optional application/runtime overrides
PORT=3000
NODE_ENV=development
CI=
