datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  createdAt                DateTime
  updatedAt                DateTime
  role                     String?
  banned                   Boolean?
  banReason                String?
  banExpires               DateTime?
  onboardingComplete       Boolean                      @default(false)
  paymentsCustomerId       String?
  locale                   String?
  twoFactorEnabled         Boolean?
  lastActiveOrganizationId String?
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  invitations              Invitation[]
  purchases                Purchase[]
  members                  Member[]
  twofactors               TwoFactor[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]
  orders                   Order[]
  githubKitGrants          GithubKitGrant[]
  buyerDeployments         BuyerDeployment[]
  supportTickets           SupportTicket[]
  lessonProgresses         LessonProgress[]
  watchTimeLogs            WatchTimeLog[]
  courseSubscriptions      CourseSubscription[]
  pluginContents           PluginContent[]
  quizAttempts             QuizAttempt[]
  assignmentSubmissions    AssignmentSubmission[] @relation("AssignmentSubmissionUser")
  assignmentUploadIntents  AssignmentUploadIntent[] @relation("AssignmentUploadIntentUser")
  assignmentReviews        AssignmentReview[] @relation("AssignmentReviewReviewer")
  assignmentDrafts         AssignmentDraft[] @relation("AssignmentDraftUser")
  courseReviews            CourseReview[]
  reviewHelpfulVotes       ReviewHelpful[]
  reviewReports            ReviewReport[]
  lessonComments           LessonComment[]
  lessonPrivateMessages    LessonPrivateMessage[]
  lessonMessageUploadIntents LessonMessageUploadIntent[]
  courseInviteRedemptions  CourseInviteRedemption[]
  onboardingSurveyResponses CourseOnboardingSurveyResponse[]
  courseInstructorAssignments CourseInstructor[] @relation("CourseInstructorUser")
  createdCourseInstructorAssignments CourseInstructor[] @relation("CourseInstructorCreator")
  adminLogs                AdminLog[]              @relation("AdminLogAdmin")
  mcpConnections           McpConnection[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  priceId        String
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@map("purchase")
}

enum NotificationTarget {
  IN_APP
  EMAIL
}

enum NotificationType {
  WELCOME
  APP_UPDATE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("notification")
}

model UserNotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  target    NotificationTarget
  createdAt DateTime           @default(now())

  @@unique([userId, type, target])
  @@map("user_notification_preference")
}

enum OrderStatus {
  pending
  paid
  refunded
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  success   Boolean
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempt")
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminLogAdmin", fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_log")
}

model Order {
  id               String      @id @default(cuid())
  orderNo          String      @unique
  userId           String
  sku              String
  amount           Int
  currency         String      @default("TWD")
  status           OrderStatus @default(pending)
  paymentGateway   String      @default("payuni")
  gatewayTradeNo   String?     @unique
  courseAccess     Boolean     @default(false)
  kitClaimEligible Boolean     @default(false)
  paidAt           DateTime?
  refundedAt       DateTime?
  invoiceType      String?
  invoiceCarrierType String?
  invoiceCarrierId String?
  invoiceTaxId     String?
  invoiceTitle     String?
  invoiceAddress   String?
  invoiceLoveCode  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice          Invoice?

  @@index([userId])
  @@map("order")
}

enum GithubKitGrantStatus {
  invited
  accepted
  revoked
  failed
}

model GithubKitGrant {
  id           String               @id @default(cuid())
  userId       String
  githubUserId String
  githubLogin  String
  org          String
  repo         String
  permission   String               @default("pull")
  status       GithubKitGrantStatus
  orderNo      String?
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, org, repo])
  @@index([userId])
  @@index([githubLogin])
  @@map("github_kit_grants")
}

model SiteSetting {
  id         String   @id
  ciphertext String   @db.Text
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  @@index([updatedAt], map: "site_setting_updated_at_idx")
  @@map("site_setting")
}

enum BuyerDeploymentTier {
  self_hosted
  managed
  advanced
}

enum BuyerDeploymentStatus {
  provisioning
  live
  building
  error
}

enum SupportTicketChannel {
  WEB_WIDGET
  LINE
  TELEGRAM
}

enum SupportTicketStatus {
  OPEN
  AI_SUGGESTED_RESOLVED
  RESOLVED
  ESCALATED
}

enum SupportTicketResolvedBy {
  BUYER_CONFIRMED
  AUTO_TIMEOUT
}

model BuyerDeployment {
  id               String                 @id @default(cuid())
  userId           String
  tier             BuyerDeploymentTier
  coolifyServerId  String?
  coolifyAppId     String?
  publicUrl        String
  customDomain     String?
  status           BuyerDeploymentStatus  @default(provisioning)
  lastDeployedAt   DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  supportTickets   SupportTicket[]

  @@index([userId])
  @@map("buyer_deployment")
}

model SupportTicket {
  id                    String                   @id @default(cuid())
  buyerDeploymentId     String?
  buyerDeployment       BuyerDeployment?        @relation(fields: [buyerDeploymentId], references: [id])
  userId                String
  user                  User                     @relation(fields: [userId], references: [id])
  chatwootConversationId Int                      @unique
  channel               SupportTicketChannel
  status                SupportTicketStatus      @default(OPEN)
  aiSuggestedResolvedAt DateTime?
  resolvedAt            DateTime?
  resolvedBy            SupportTicketResolvedBy?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([buyerDeploymentId])
  @@index([status])
  @@index([aiSuggestedResolvedAt])
}

enum VideoProvider {
  BUNNY
  YOUTUBE
  VIMEO
  CUSTOM_MP4
  HLS
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionInterval {
  MONTH
  YEAR
}

enum CourseSubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
}

enum PaymentWebhookEventStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?       @db.Text
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chapters    Chapter[]
  subscriptionPlans CourseSubscriptionPlan[]
  subscriptions CourseSubscription[]
  invites      CourseInvite[]
  inviteRedemptions CourseInviteRedemption[]
  onboardingSurveyResponses CourseOnboardingSurveyResponse[]
  instructors CourseInstructor[]
  watermarkSetting CourseVideoWatermarkSetting?

  @@map("course")
}

model CourseInstructor {
  id          String   @id @default(cuid())
  courseId    String
  userId      String
  createdById String
  createdAt   DateTime @default(now())

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User   @relation("CourseInstructorUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User   @relation("CourseInstructorCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([courseId, userId])
  @@index([userId])
  @@map("course_instructor")
}

model CourseVideoWatermarkSetting {
  id                String   @id @default(cuid())
  courseId          String   @unique
  enabled           Boolean  @default(false)
  showEmail         Boolean  @default(true)
  showCourseTitle   Boolean  @default(true)
  showTimestamp     Boolean  @default(true)
  emailDisplayMode  String   @default("FULL")
  opacityPercent    Int      @default(18)
  textSize          String   @default("MD")
  movementMode      String   @default("STANDARD")
  moveIntervalSec   Int      @default(12)
  tamperPauseEnabled Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@map("course_video_watermark_setting")
}

model CourseSubscriptionPlan {
  id        String               @id @default(cuid())
  courseId  String
  course    Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  label     String
  interval  SubscriptionInterval
  price     Int
  sku       String               @unique
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  subscriptions CourseSubscription[]

  @@index([courseId])
  @@map("course_subscription_plan")
}

model CourseSubscription {
  id                    String                   @id @default(cuid())
  userId                String
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId              String
  course                Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  planId                String
  plan                  CourseSubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                CourseSubscriptionStatus @default(PENDING)
  gatewayTradeNo        String                   @unique
  gatewaySubscriptionId String?
  interval              SubscriptionInterval
  pricePerPeriod        Int
  paidPeriods           Int                      @default(0)
  currentPeriodEnd      DateTime?
  lastPaymentAt         DateTime?
  canceledAt            DateTime?
  invoiceType           String?
  invoiceCarrierType    String?
  invoiceCarrierId      String?
  invoiceTaxId          String?
  invoiceTitle          String?
  invoiceAddress        String?
  invoiceLoveCode       String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  invoices              Invoice[]

  @@index([userId])
  @@index([courseId])
  @@index([userId, courseId])
  @@map("course_subscription")
}

model CourseInvite {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  email      String?
  maxUses    Int?
  usedCount  Int      @default(0)
  expiresAt  DateTime?
  active     Boolean  @default(true)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  redemptions CourseInviteRedemption[]

  @@index([courseId])
  @@index([active, expiresAt])
  @@map("course_invite")
}

model CourseInviteRedemption {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  inviteId   String
  invite     CourseInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  redeemedAt DateTime     @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([inviteId])
  @@map("course_invite_redemption")
}

model Invoice {
  id             String             @id @default(cuid())
  orderId        String?            @unique
  order          Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   CourseSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodNumber   Int?
  provider       String
  status         String             @default("PENDING")
  invoiceNumber  String?
  randomCode     String?
  invoiceDate    DateTime?
  amount         Int
  allowanceTotal Int                @default(0)
  failReason     String?
  attentionReason String?
  rawResponse    Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([invoiceNumber])
  @@index([status])
	@@index([subscriptionId, periodNumber], map: "invoice_subscription_period_idx")
  @@map("invoice")
}

model PaymentWebhookEvent {
  id        String                    @id @default(cuid())
  gateway   String
  eventId   String
  eventType String
  status    PaymentWebhookEventStatus @default(PROCESSING)
  payload   Json
  error     String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([gateway, eventId])
  @@map("payment_webhook_event")
}

model Chapter {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
  @@map("chapter")
}

model Lesson {
  id              String         @id @default(cuid())
  chapterId       String
  slug            String         @unique
  title           String
  content         String?        @db.Text
  isFreePreview   Boolean        @default(false)
  order           Int            @default(0)
  status          PublishStatus  @default(PUBLISHED)
  videoProvider   VideoProvider?
  videoUrl        String?
  videoDuration   String?
  aiPrompt        String?        @db.Text
  aiContext       String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  chapter         Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progresses      LessonProgress[]
  watchTimeLogs   WatchTimeLog[]
  privateMessages  LessonPrivateMessage[]
  privateMessageUploadIntents LessonMessageUploadIntent[]

  @@index([chapterId])
  @@map("lesson")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model WatchTimeLog {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  watchedSec  Int      @default(0)
  lastWatchAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("watch_time_log")
}

model LessonPrivateMessage {
  id                    String   @id @default(cuid())
  lessonId              String
  userId                String
  content               String   @db.Text
  attachmentStorageKey  String?
  attachmentName        String?
  attachmentMimeType    String?
  attachmentSize        Int?
  isFromTeacher         Boolean  @default(false)
  readByTeacher         Boolean  @default(false)
  createdAt             DateTime @default(now())

  lesson                Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, userId, createdAt])
  @@index([readByTeacher, createdAt])
  @@map("lesson_private_message")
}

enum LessonMessageUploadIntentStatus {
  PENDING
  FINALIZED
  CLEANING
}

model LessonMessageUploadIntent {
  id           String                         @id @default(cuid())
  lessonId     String
  userId       String
  storageKey   String                         @unique
  filename     String
  contentType  String
  size         Int
  status       LessonMessageUploadIntentStatus @default(PENDING)
  expiresAt    DateTime
  cleanupClaimedAt DateTime?
  createdAt    DateTime                       @default(now())

  lesson       Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt, cleanupClaimedAt])
  @@index([status, createdAt])
  @@map("lesson_message_upload_intent")
}

model SidebarGroup {
  id          String   @id @default(cuid())
  title       String
  order       Int
  isCollapsed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       SidebarGroupItem[]
}

model SidebarGroupItem {
  id         String   @id @default(cuid())
  groupId    String
  menuItemId String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group      SidebarGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId])
  @@index([groupId])
}

model PluginContent {
  id        String   @id @default(cuid())
  pluginId  String
  type      String
  title     String
  body      Json
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([pluginId, type])
  @@index([authorId])
}

model AssignmentSubmission {
  id              String   @id @default(cuid())
  pluginContentId String
  userId          String
  content         String?  @db.Text
  contentFormat   String?
  wordCount       Int?
  status          String   @default("DRAFT")
  revisionNumber  Int      @default(1)
  isLate          Boolean  @default(false)
  submittedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User                  @relation("AssignmentSubmissionUser", fields: [userId], references: [id], onDelete: Cascade)
  attachments     AssignmentAttachment[]
  uploadIntents   AssignmentUploadIntent[]
  reviews         AssignmentReview[]

  @@index([pluginContentId, userId])
  @@index([pluginContentId, status, submittedAt])
  @@index([userId, createdAt])
  @@unique([pluginContentId, userId, revisionNumber])
  @@map("assignment_submission")
}

model AssignmentUploadIntent {
  id              String   @id
  pluginContentId String
  submissionId    String
  userId          String
  filename        String
  mimeType        String
  size            Int
  storageKey      String   @unique
	status          String   @default("PENDING")
	expiresAt       DateTime
	cleanupClaimedAt DateTime?
	createdAt       DateTime @default(now())

  user       User                 @relation("AssignmentUploadIntentUser", fields: [userId], references: [id], onDelete: Cascade)
  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

	@@index([submissionId, status])
	@@index([userId, pluginContentId, status])
	@@index([status, expiresAt, cleanupClaimedAt])
  @@map("assignment_upload_intent")
}

model AssignmentAttachment {
  id           String   @id @default(cuid())
  submissionId String
  filename     String
  mimeType     String
  size         Int
  storageKey   String
  createdAt    DateTime @default(now())

  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("assignment_attachment")
}

model AssignmentReview {
  id           String   @id @default(cuid())
  submissionId String
  reviewerId   String
  feedback     String?  @db.Text
  score        Int?
  letterGrade  String?
  reviewedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     User                  @relation("AssignmentReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("assignment_review")
}

model AssignmentDraft {
  id              String   @id @default(cuid())
  pluginContentId String
  userId          String
  content         String?  @db.Text
  contentFormat   String?
  revision        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation("AssignmentDraftUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pluginContentId, userId])
  @@index([userId])
  @@map("assignment_draft")
}

model CourseReview {
  id           String   @id @default(cuid())
  courseId     String
  userId       String
  rating       Int
  content      String?  @db.Text
  isVisible    Boolean  @default(true)
  helpfulCount Int      @default(0)
  replyContent String?  @db.Text
  replyAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpfulVotes ReviewHelpful[]
  reports      ReviewReport[]

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_review")
}

model CourseOnboardingSurveyResponse {
  id                    String   @id @default(cuid())
  userId                String
  courseId              String
  goals                 String[] @default([])
  purchaseFactors       String[] @default([])
  hesitation            String?  @db.Text
  alternatives          String?  @db.Text
  discoverySource       String?
  discoverySourceOther  String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_onboarding_survey_response")
}

model ReviewHelpful {
  id        String       @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime     @default(now())

  review    CourseReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@map("review_helpful")
}

model ReviewReport {
  id        String       @id @default(cuid())
  reviewId  String
  userId    String
  reason    String       @db.Text
  createdAt DateTime     @default(now())

  review    CourseReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@map("review_report")
}

model LessonComment {
  id          String    @id @default(cuid())
  lessonId    String
  userId      String
  content     String    @db.Text
  isAnonymous Boolean   @default(false)
  isRead      Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt])
  @@map("lesson_comment")
}

model QuizAttempt {
  id                String   @id @default(cuid())
  userId            String
  pluginContentId   String
  answers           Json
  score             Int
  passed            Boolean
  timeTakenSeconds  Int?
  startedAt         DateTime @default(now())
  submittedAt       DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pluginContentId])
  @@map("quiz_attempt")
}

model McpConnection {
  id           String    @id @default(cuid())
  userId       String
  clientName   String
  authorizedAt DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcp_connection")
}

model StudioFolder {
  id          String             @id @default(cuid())
  name        String
  order       Int                @default(0)
  isCollapsed Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  items       StudioFolderItem[]

  @@map("studio_folder")
}

model StudioFolderItem {
  id        String       @id @default(cuid())
  folderId  String
  moduleId  String
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  folder    StudioFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([folderId, moduleId])
  @@index([folderId])
  @@map("studio_folder_item")
}

model StudioFolderCollapseState {
  id          String   @id @default(cuid())
  userId      String
  folderId    String
  isCollapsed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, folderId])
  @@index([folderId])
  @@index([userId])
  @@map("studio_folder_collapse_state")
}

model Bundle {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String?
  priceTwd    Int
  status      String         @default("draft")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  courses     BundleCourse[]

  @@index([status])
}

model BundleCourse {
  id       String @id @default(cuid())
  bundleId String
  courseId String
  order    Int    @default(0)

  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([bundleId, courseId])
}

model Coupon {
  id                String    @id @default(cuid())
  code              String    @unique
  discountType      String
  amountOff         Int?
  percentOff        Int?
  maxDiscountAmount Int?
  maxRedemptions    Int?
  timesRedeemed     Int       @default(0)
  active            Boolean   @default(true)
  startsAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([active])
}
